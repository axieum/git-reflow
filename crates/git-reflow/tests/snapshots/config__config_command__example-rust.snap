---
source: crates/git-reflow/tests/config.rs
expression: "String::from_utf8_lossy(&assert.get_output().stdout)"
---
{
  "git": {
    "provider": {
      "github": {
        "host": "api.github.com",
        "commit-via-api": true
      }
    },
    "release-branch-prefix": "reflow--branches--",
    "commit-message-pattern": "chore{{#if scope}}({{ scope }}){{/if}}: release v{{ version }}",
    "separate-pull-requests": false,
    "tag-major-and-minor": true
  },
  "exclude": [],
  "packages": [
    {
      "dir": ".",
      "name": "example-rust",
      "scope": null,
      "strategy": {
        "rust": {}
      },
      "workspace": true,
      "include-name-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "include-changes": [],
      "tag-only": false,
      "make-latest": true
    }
  ]
}
