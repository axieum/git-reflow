---
source: crates/git-reflow/tests/config.rs
expression: "String::from_utf8_lossy(&assert.get_output().stdout)"
---
{
  "git": {
    "provider": {
      "github": {
        "host": "api.github.com",
        "commit-via-api": true
      }
    },
    "release-branch-prefix": "reflow--branches--",
    "commit-message-pattern": "chore{{#if scope}}({{ scope }}){{/if}}: release v{{ version }}",
    "separate-pull-requests": false,
    "tag-major-and-minor": true
  },
  "branches": [
    {
      "name": "^(main|master)$",
      "pre-release": null
    },
    {
      "name": "^release/.+$",
      "pre-release": "rc"
    },
    {
      "name": "^dev(elop)?$",
      "pre-release": "beta"
    },
    {
      "name": "^beta$",
      "pre-release": "beta"
    },
    {
      "name": "^alpha$",
      "pre-release": "alpha"
    }
  ],
  "exclude": [],
  "packages": [
    {
      "dir": ".",
      "name": "example-python",
      "scope": null,
      "strategy": {
        "python": {}
      },
      "workspace": true,
      "include-name-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "include-changes": [],
      "update-files": [],
      "tag-only": false,
      "make-latest": true
    }
  ]
}
