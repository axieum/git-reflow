diff --git a/uv.lock b/uv.lock
index [COMMIT SHA]..[COMMIT SHA] 100644
--- a/uv.lock
+++ b/uv.lock
@@ -11,12 +11,12 @@ members = [
 
 [[package]]
 name = "example-api"
-version = "1.0.0"
+version = "1.1.0"
 source = { editable = "packages/example-api" }
 
 [[package]]
 name = "example-cli"
-version = "1.0.0"
+version = "1.0.1"
 source = { editable = "packages/example-cli" }
 dependencies = [
     { name = "example-api" },
@@ -27,5 +27,5 @@ requires-dist = [{ name = "example-api", editable = "packages/example-api" }]
 
