 dependencies = [
   "example-api",
diff --git a/pyproject.toml b/pyproject.toml
index [COMMIT SHA]..[COMMIT SHA] 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,6 +1,6 @@
